FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY nest-cli.json ./

# Install dependencies
RUN npm install

# Copy prisma schemas and shared library
COPY prisma ./prisma
COPY libs ./libs

# Copy all service folders
COPY apps ./apps

# Generate root Prisma client (for shared PrismaService)
RUN npx prisma generate

# Generate Prisma clients for all services (if they have individual schemas)
RUN cd apps/auth-service && npx prisma generate || true
RUN cd apps/catalog-service && npx prisma generate || true
RUN cd apps/inventory-service && npx prisma generate || true
RUN cd apps/orders-service && npx prisma generate || true

# Expose common ports (optional, mainly for documentation)
EXPOSE 3000 3001 3002 3003 3004

# Default command will be overridden by docker-compose
CMD ["npm", "run", "start:dev"]
