# Database Configuration
POSTGRES_USER=pureshop_user
POSTGRES_PASSWORD=pureshop_password
POSTGRES_DB=pureshop_db

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Redis Configuration
REDIS_URL=redis://redis:6379

# General Application Settings
NODE_ENV=development
LOG_LEVEL=debug

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRATION=24h
BCRYPT_ROUNDS=10

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://auth-service:3001
CATALOG_SERVICE_URL=http://catalog-service:3002
INVENTORY_SERVICE_URL=http://inventory-service:3003
ORDER_SERVICE_URL=http://order-service:3004
PAYMENT_SERVICE_URL=http://payment-service:3005
NOTIFICATION_SERVICE_URL=http://notification-service:3006

# Stripe Configuration (for Payment Service)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_API_VERSION=2023-10-16
IDEMPOTENCY_KEY_ENABLED=true

# Email Configuration (for Notification Service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@pureshop.com
MAIL_FROM_NAME=PureShop

# WebSocket Configuration
WEBSOCKET_NAMESPACE=notifications
WEBSOCKET_CORS_ORIGIN=*
MAX_NOTIFICATION_HISTORY=100

# Frontend URL
FRONTEND_URL=http://localhost:3000